title: ...vs Gold Trigon
new-page: true
on-arrival: {!
Q.gold_trigon_turn = 1;

Q.combat_cutscene_queue = [];

window.setCombatHand(true);

window.clearCombatStatsIfNeeded = function() {
    if (Q.selected_combatant) {
        window.cancelPendingCombatCutscene(Q.selected_combatant);
    }
    if (Q[Q.selected_combatant + "_action"] == "strategize") {
        for (var c of Q.combatants) {
            Q[c + "_plan"] = "";
        }
    } else if (Q[Q.selected_combatant+"_target"] != "") {
        var former_target = Q[Q.selected_combatant+"_target"];
        Q[Q.selected_combatant+"_target"] = "";
        var other_targeters = 0;
        for (var c of Q.combatants) {
            if (Q[c+"_target"] == former_target) {
                other_targeters = 1
            }
        }
        if (other_targeters == 0) {
            if (Q[former_target+"_action"] == "immobile") {
                Q[former_target+"_action"] = "";
            }
        }
    }
};

const content = document.getElementById('content');

const choices = window.dendryUI.dendryEngine.getCurrentChoices();
console.log(choices);

Q.gold_trigon_hp = 100;

Q.hilferding_hp = 21;
Q.hilferding_att = 3;
Q.hilferding_def = 9;
Q.hilferding_sta = 5;
Q.hilferding_sta_m = 5;
Q.hilferding_hp_m = 21;
Q.hilferding_action = "";
Q.hilferding_target = "";
Q.hilferding_plan = "";
Q.hilferding_present_plan = "";

Q.wels_hp = 19;
Q.wels_att = 7;
Q.wels_def = 4;
Q.wels_sta = 9;
Q.wels_sta_m = 9;
Q.wels_hp_m = 19;
Q.wels_action = "";
Q.wels_target = "";
Q.wels_plan = "";
Q.wels_present_plan = "";

Q.muller_hp = 11;
Q.muller_att = 4;
Q.muller_def = 4;
Q.muller_sta = 5;
Q.muller_sta_m = 5;
Q.muller_hp_m = 11;
Q.muller_action = "";
Q.muller_target = "";
Q.muller_plan = "";
Q.muller_present_plan = "";

Q.breitscheid_hp = 24;
Q.breitscheid_att = 6;
Q.breitscheid_def = 6;
Q.breitscheid_sta = 4;
Q.breitscheid_sta_m = 4;
Q.breitscheid_hp_m = 24;
Q.breitscheid_action = "";
Q.breitscheid_target = "";
Q.breitscheid_plan = "";
Q.breitscheid_present_plan = "";

Q.planning_combat = 0;
Q.plan_is_done = 0;

Q.choosing_target = 0;
Q.selected_combatant = 0;
Q.selected_target = 0;

const engine = window.dendryUI.dendryEngine;

Q.combat_allow_softlock = 1;

Q.everyone_is_done = 0;

!}
go-to: menu

= ...vs Gold Trigon

<div class="gold-trigon"></div>

<div class="combat-dialogue">
  <div class="combat-dialogue-portrait">
    <img id="combat-dialogue-image" src="" alt="">
  </div>
  <div id="combat-dialogue-text" class="combat-dialogue-text"></div>
</div>

@gallbladder_achievement
achievement: gallbladder
go-to: menu

@menu
go-to: gallbladder_achievement if gallbladder_achievement and not achievement_gallbladder
on-arrival: {!
const engine = window.dendryUI.dendryEngine;

Q.combatants = [];

const combatantIds = engine.game.tagLookup["combatant"] || {};

for (const id in combatantIds) {
  const scene = engine.game.scenes[id];

  if (!scene) {
    continue;
  }

  if (scene.viewIf && !engine._runPredicate(scene.viewIf, true)) {
    continue;
  }

Q.combatants.push(id.split(".").pop().replace(/_c$/, ""));

}

document.querySelectorAll('.combat-advisor-screen').forEach(el => el.remove());

window.setCombatHand(true);

if (!Q.doraemon_spoke) {
    window.startCombatCutscene([
        ["doraemon", "Holy smokes, woah, hey, get back here! Hey! That's not safe! It'll kill you guys!"]
    ]);
    Q.doraemon_spoke = 1;

} else if (Q.doraemon_spoke == 1) {
    window.startCombatCutscene([
        ["doraemon", "Really guys, be responsible now! This is absolutely unsafe, every little bit of it. I mean, really, really unsafe stuff we're talking about here. It literally evaporated Hitler!"]
    ]);
    Q.doraemon_spoke += 1;

} else if (Q.doraemon_spoke == 2) {
    window.startCombatCutscene([
        ["doraemon", "Well, okay. If you guys insist on fighting it, I'll um...I'm cheering for you! And, if you decide to change your minds, I'll show you all to the time machine!"]
    ]);
    Q.doraemon_spoke += 1;
}

Q.everyone_is_done = 1;
for (var c of Q.combatants) {
    if (Q[c+'_action'] == "") {
        Q.everyone_is_done = 0;
    }
}
if (Q.choosing_target) {
    Q.everyone_is_done = 0;
}

Q.plan_is_done = 1;
if (Q.planning_combat) {
    for (var c of Q.combatants) {
        if (Q[c + "_plan"] == "") {
            Q.plan_is_done = 0;
        }
    }
}

Q.was_already_planning_combat = 0;

!}

