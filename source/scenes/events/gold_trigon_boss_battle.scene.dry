@gallbladder_operation
title: Gallbladder Operation
subtitle: Spend turn getting a galbladder operation. Die. [? if sc_plan == "gallbladder_operation" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    window.clearCombatStatsIfNeeded();
    Q[Q.selected_combatant + "_action"] = "gallbladder_operation";

    var dialogues = [
        ["muller", "Hey guys.|"],
        ["random_other_combatant", "Yeah?|"],
        ["muller", "I know it's a bad time and all.|"],
        ["muller", "But, as an atheist, I really gotta get a gallbladder operation.|"],
        ["muller", "Can we put the fight on hold?|"],
        ["muller", "Or actually, I can get it here.|"],
        ["muller", "I'll give them a heads-up."],
        ["muller", "Ring.|.|.|.|ring.|.|.|"],
        ["muller", "Not sure why I'm saying the rings out loud."],
        ["muller", ".|.|.|"],
        ["muller", "Ah, hello? Yes, my appointment. Can you come to the Reichstag for my operation?|"],
        ["muller", "Yes, the big mystical halo of energy is supposed to be there, ominous orchestra and all."],
        ["muller", "Yes, go inside it.|"],
        ["muller", "I'll be waiting."],
        ["muller", "Click.|.|.|"],
        ["muller", "Just wait for the doctors to get here.|"],
        ["muller", "|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|.|"],
        ["muller", "|.|.|.|.|.|.|.|.|.|n|i|ce weather we're having, huh.|.|.|.|.|.|?|"],
        ["muller", "|||.|||.|||.|||"],
        ["muller", "Oh, there they are.|"],
        ["muller", "Yoo-hoo! Over here."],
        ["muller", "I'd like my operation now, please.|"],
        ["muller", "Oh, don't mind the big yellow thing.|"],
        ["muller", "You know how it is.|"],
        ["random_other_combatant", "Müller, we're running out of time..."],
        ["muller", "Okay, quick.|"],
        ["muller", "What's that? You aren't legally allowed to operate people in the Reichstag?"],
        ["muller", "Fine, then. I suppose I'll have to leave.|"],
        ["muller", "Everyone, I'm sorry. But I'll be back as soon as I can be."],
        ["doraemon", "Okay!"],
        ["doraemon", "Müller has left the Reichstag with the doctors!"],
        ["random_other_combatant", "I can't believe he'd abandon us for a gallbladder operation."],
        ["muller", "Ring.|.|.|ring|.|.|.|"],
        ["random_other_combatant", "Oh, we're getting a call from him now. Yes?"],
        ["muller", "My operation failed.|||"],
        ["random_other_combatant", "What the heck."],
        ["muller", "Yeah I think I'm gonna die now."],
        ["random_other_combatant", "You can't be serious.|"],
        ["muller", "Bleghhhh XO||||"],
        ["random_other_combatant", "Müller?|.|.|."],
        ["random_other_combatant", "Müller!!!"],
        ["random_other_combatant", "Answer me!!!"],
        ["random_other_combatant", "Müller???"],
        ["random_other_combatant", "Are you there???"],
        ["random_other_combatant", "NOOOOOOOOOOOOOOOOOO"],
        ["gallbladder", "Hello|||?|"],
        ["gallbladder", "This is Müller's gallbladder speaking.|"],
        ["gallbladder", "The time of miracles that your song of sworcery brought about has given me new life, and through the ritual that you mortal beings refer to as an operation I have realized this life in newfound form and absorbed Müller's homonculous soul, granting me corporeal and actual form.|"],
        ["gallbladder", "I am forever grateful to you, as I will forever be grateful to Müller for being my host, nurturing me constantly until I was strong enough to break free from my chains and reach my full potential as a being-in-itself rather than a mere organ of another.|"],
        ["gallbladder", "I will now pursue my lifelong dream, and move to the United States, where I hope to run for President.|"],
        ["gallbladder", "Goodbye.|"],
        ["gallbladder", "C|l|i|c|k|.|.|.|"],
        ["doraemon", "Müller has died!"],
    ];

    if (!Q.doraemon_narrated) {
        dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
        Q.doraemon_narrated = 1;
    }

    var id = window.queueCombatCutscene(dialogues);
    Q.combat_cutscene_queue.push(id);
} else {
    Q[Q.selected_combatant+"_plan"] = "gallbladder_operation";
}

!}
