- @menu: Return

@defend
title: Take a defensive stance and attempt to heal.
choose-if: sc_stamina >= 1
subtitle: An ordinary defense, regaining 1 HP. (1 stamina) [? if sc_plan == "defend" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    window.clearCombatStatsIfNeeded();
    Q[Q.selected_combatant + "_action"] = "defend";
    if (Q.selected_combatant == "wels") {
        Q.wels_defends = (Q.wels_defends || 0) + 1;

        var defendsDialogues = {
            1: [
                ["wels", "Peace-lovin' man, I'm a peace-lovin' man..."],
                ["wels", "Wait, that's already been referenced somewhere else in the game?|"],
                ["wels", "Okay, sorry."],
                ["doraemon", "Wels has defended!!!"],
            ],
            2: [
                ["wels", "I don't really have anything cooler to say, to be honest.|"],
                ["doraemon", "Wels has defended!!!"],
            ],
            3: [
                ["wels", "These recent moves I've been making are low-key a waste of my talents.|"],
                ["doraemon", "Wels has defended!!!"],
            ],
        };

        var dialogues = defendsDialogues[Q.wels_defends] || [
            ["wels", "I'm boring..."],
            ["doraemon", "Wels has defended!!!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    } else if (Q.selected_combatant == "hilferding") {
        Q.hilferding_defends = (Q.hilferding_defends || 0) + 1;

        var defendsDialogues = {
            1: [
                ["hilferding", "Obviously, I'm familiar with the hippocratic oath.|"],
                ["hilferding", "What I'm doing right now has pretty much nothing to do with it.|"],
                ["hilferding", "I don't know why it's considered descriptive here, it isn't very apt.|"],
                ["hilferding", "Regardless, my skills are suited here to self-treatment and self-care.|"],
                ["hilferding", "Even if I would rather be doing something more useful.|"],
                ["hilferding", "Which, would really be of greater use.|"],
                ["hilferding", "By,| w|e|l|l|,| the definition of the word useful."],
                ["doraemon", "Hilferding has defended!!!"],
            ],
            2: [
                ["hilferding", "I suppose I shouldn't overlook the potential tactical utility that this has..."],
                ["hilferding", "But surely there is more I could be doing?|"],
                ["hilferding", "Then again, I supported doing pretty much nothing for like,||| the entire Great Depression."],
                ["hilferding", "Except those moments I didn't|, which you gotta give me credit for, by the way.|"],
                ["hilferding", "Really, I think my legacy isn't nearly as bad as it's made out to be.|"],
                ["hilferding", "Why isn't anyone talking about the actual plans I had? I wasn't just some ||chud|| advocating for us to do nothing all the time. I had ideas!"],
                ["hilferding", "I wrote Finance Capital! Vladimir Lenin was influenced by that!"],
                ["hilferding", "Plus, I did have actual ideas for things to actually do during the period of the Great Depression, too. They'd still probably work, but somehow I feel like they're not relevant now that this whole cosmic geometry thing has taken the stage. Regardless..."],
                ["hilferding", "The point is, I didn't really advocate for doing nothing, it was just the practical effect of the policies I advocated."],
                ["hilferding", "Which you can only really know with hindsight!"],
                ["hilferding", "My ideas were perfectly sensible. Haven't even been discredited yet, but the Megatome seems to think they will be."],
                ["hilferding", "Y'know, those time travelers who were here moments ago? They're probably Keynesians."],
                ["hilferding", "Don't ask me my thoughts on Keynesians."],
                ["woytinsky", "..."],
                ["hilferding", "Ew."],
                ["doraemon", "Okay, wrap it up. Your monologue is over."],
                ["doraemon", "Hilferding has defended!!!"],
            ],
            3: [
                ["hilferding", "Returning to my point on Keynesians...|"],
                ["hilferding", "Deficit spending is an utterly reckless policy. I mean, you have to consider that Germany doesn't exist in a vacuum, for one.|"],
                ["hilferding", "Foreign countries will see deficit spending - the Entente powers - and change their evaluation of our currency's value, or reparations attitude, accordingly."],
                ["hilferding", "It makes far more sense to negotiate to alleviate the reparations burden, which we can do more easily from a position of strengthening our currency."],
                ["hilferding", "Then, we can further make agreements to cut tariffs, and stimulate international investment again."],
                ["hilferding", "It should be no surprise that a global crisis requires a global response."],
                ["hilferding", "Anyway, defense."],
                ["doraemon", "Hilferding has defended!!!"],
            ],
        };

        var dialogues = defendsDialogues[Q.hilferding_defends] || [
            ["hilferding", "If you want to hear more about my economic opinions, you can read my works."],
            ["doraemon", "Hilferding has defended!!!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    } else if (Q.selected_combatant == "muller") {
        Q.muller_defends = (Q.muller_defends || 0) + 1;

        var defendsDialogues = {
            1: [
                ["muller", "Self-defense, huh? I'm actually pretty well-versed in that.|"],
                ["muller", "As an atheist, it's important to be vigilant and attentive to your health.|"],
                ["muller", "Did you know I was the only chancellor to not belong to any religion?|"],
                ["muller", "Uh...wait, was I chancellor?|"],
                ["doraemon", "Müller has defended!!!"],
            ],
            2: [
                ["muller", "My memory is pretty poor, as an atheist.|"],
                ["muller", "I hear that communing with gods allows you to have them remember things for you. Is that true?|"],
                ["muller", "Either way, as a white guy, I find that gallbladders fill a similar niche.|"],
                ["doraemon", "Müller has defended!!!"],
            ],
            3: [
                ["muller", "I got some breadcrumbs from a priest in another life, as a pigeon.|"],
                ["doraemon", "Müller has defended!!!"],
            ],
        };

        var dialogues = defendsDialogues[Q.muller_defends] || [
            ["muller", "I think I'm going weird...|"],
            ["doraemon", "Müller has defended!!!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    } else if (Q.selected_combatant == "breitscheid") {
        Q.breitscheid_defends = (Q.breitscheid_defends || 0) + 1;

        var defendsDialogues = {
            1: [
                ["breitscheid", "Yeah, that makes sense.|"],
                ["doraemon", "Breitscheid has defended!!!"],
            ],
            2: [
                ["breitscheid", "The attacks from this geometrical thing are totally a massive bummer, and I'm not super jazzed by incineration, so I think this is definitely the best idea. I don't dig the alternatives.|"],
                ["breitscheid", "At the same time though, while I don't like it one bit, one of us has to get about to...taming that thing, somehow.|"],
                ["doraemon", "Breitscheid has defended!!!"],
            ],
            3: [
                ["breitscheid", "If only we had firepower. Like, a rocket launcher, or something. Just a thought.|"],
                ["doraemon", "Breitscheid has defended!!!"],
            ],
        };

        var dialogues = defendsDialogues[Q.breitscheid_defends] || [
            ["breitscheid", "Roger roger."],
            ["doraemon", "Breitscheid has defended!!!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    }
} else {
    Q[Q.selected_combatant+"_plan"] = "defend";
}
!}

