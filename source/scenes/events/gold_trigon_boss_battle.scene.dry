- @menu: Return

@attack
title: Attack the **<span style="color:rgb(255, 208, 0);font-family:'Times New Roman',serif;font-weight:700;letter-spacing:0.5px;">Gold Trigon</span>**.
subtitle: An ordinary attack, dealing damage. (1 stamina) [? if sc_plan == "attack" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    window.clearCombatStatsIfNeeded();
    Q[Q.selected_combatant + "_action"] = "attack";
    if (Q.selected_combatant == "wels") {
        Q.wels_attacks = (Q.wels_attacks || 0) + 1;

        var attacksDialogues = {
            1: [
                ["wels", "Prepare for trouble!|"],
                ["wels", "And make it, uh, single, cause, I'm alone...||"],
                ["wels", "But single or not, I'm gonna beat you down, Mr. Triangle Man. Or woman."],
                ["doraemon", "Wels has attacked!!!"],
            ],
            2: [
                ["wels", "Ready for round two? Here goes, trianglekid.|"],
                ["doraemon", "Wels has attacked!!!"],
            ],
            3: [
                ["wels", "You're done for."],
                ["wels", "Feel the power of my, well, I'm not gonna literally punch you, you're a big floating triangle in the air with seemingly cosmic properties, but like, my uh,||| mind-beam."],
                ["doraemon", "Wels has attacked!!!"],
            ],
        };

        var dialogues = attacksDialogues[Q.wels_attacks] || [
            ["wels", "Bam! Boom! Hai-ya!!!"],
            ["doraemon", "Wels has attacked!!!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    } else if (Q.selected_combatant == "hilferding") {
        Q.hilferding_attacks = (Q.hilferding_attacks || 0) + 1;

        var attacksDialogues = {
            1: [
                ["hilferding", "I haven't done this in years. Not since the Great Bake Sale of 1919...|"],
                ["hilferding", "But you'd be wrong to think me rusty.|"],
                ["hilferding", "Prepare yourself, psychocosmological foe, for I yield only to-"],
                ["severing", "That's my line!|"],
                ["hilferding", "My bad. Regardless..."],
                ["hilferding", "(Picture me rolling my sleeves up dramatically in a no-nonsense fashion)"],
                ["hilferding", "(I'd slug the triangle's jaw)|"],
                ["doraemon", "(Wow)|||"],
                ["hilferding", "(If it had one I mean)|"],
                ["doraemon", "(Yeah I got that)|"],
                ["hilferding", "(Good)"],
                ["doraemon", "Hilferding has attacked!!!"],
            ],
            2: [
                ["hilferding", "This is not my first rodeo, and by God, it will not be my last. You, you apparition of finance capital, shall feel the might of proletarian force.|"],
                ["hilferding", "You shall inevitably yield to your expropriation by the social-democratic movement, which champions forth history.|"],
                ["hilferding", "Brace yourself, manifestation, for-"],
                ["wissell", "Stop larping"],
                ["hilferding", "Okay fine I'll just get this over with."],
                ["hilferding", "Irregardless, it will undermine the material conditions which allow this superstructural force of production to persist."],
                ["doraemon", "Hilferding has attacked!!!"],
            ],
            3: [
                ["hilferding", "I've eaten only waffles all day.|"],
                ["hilferding", "For those not in the know, there has been a researched correlation between eating waffles and winning.|"],
                ["hilferding", "This is in contrast to pancakes, which are correlated heavily with abject failure and defeat.|"],
                ["hilferding", "I would not be surprised if cosmic geometry consumed exclusively pancakes, albeit evidently to not quite the extent of Hitler."],
                ["doraemon", "Hilferding has attacked!!!"],
            ],
        };

        var dialogues = attacksDialogues[Q.hilferding_attacks] || [
            ["hilferding", "The world is but a marble in the palm of my hand!|"],
            ["doraemon", "Hilferding has attacked!!!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    }
} else {
    Q[Q.selected_combatant+"_plan"] = "attack";
}
!}

