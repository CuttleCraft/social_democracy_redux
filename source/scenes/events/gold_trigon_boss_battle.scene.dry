@hilferding_c
title: Rudolf Hilferding
is-pinned-card: true
tags: combatant
card-image: img/portraits/HilferdingRudolf.jpg
view-if: (hilferding_advisor = 1) and (not choosing_target or (selected_combatant != "hilferding"))
choose-if: hilferding_action != "immobile"
unavailable-subtitle: Hilferding's turn is being consumed by a fellow combatant - change their action to something else
on-arrival: selected_combatant = "hilferding" if not choosing_target; selected_target = "hilferding" if choosing_target; sc_display = "Hilferding" if not choosing_target; sc_plan = hilferding_present_plan if not choosing_target
go-to: target_chosen if choosing_target

