@attack
title: Attack the **<span style="color:rgb(255, 208, 0);font-family:'Times New Roman',serif;font-weight:700;letter-spacing:0.5px;">Gold Trigon</span>**.
choose-if: sc_stamina >= 1
subtitle: An ordinary attack, dealing damage. (1 stamina) [? if sc_plan == "attack" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    window.clearCombatStatsIfNeeded();
    Q[Q.selected_combatant + "_action"] = "attack";
    if (Q.selected_combatant == "wels") {
        Q.wels_attacks = (Q.wels_attacks || 0) + 1;

        var attacksDialogues = {
            1: [
                ["wels", "Prepare for trouble!|"],
