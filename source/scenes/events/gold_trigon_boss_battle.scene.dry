- @menu: Return

@finalize_plan
view-if: planning_combat and plan_is_done
on-arrival: planning_combat = 0

<div class="combat-advisor-screen">

We have finalized the battle plan, so it may be implemented next turn.

</div>

- @menu: Return

@next_turn
choose-if: not cutscene_unfinished
unavailable-subtitle: Don't interrupt.
view-if: everyone_is_done and not planning_combat
on-arrival: {! 

if (Q.combat_cutscene_queue.length > 0) {
    window.startCombatCutscene(Q.combat_cutscene_queue.shift());
    return;
} else {
    window.startCombatCutscene([
        ["doraemon", "It's the triangle's turn!"],
    ]);
}

Q.everyone_is_done = 0;

Q.gold_trigon_turn += 1;

for (var c of Q.combatants) {
    if (Q[c+"_action"] == "strategize") {
        var stamina_cost = 3;
    } else if (Q[c+"_action"] == "medicine") {
        var stamina_cost = 5;
        var recipient = Q[c+"_target"];
        Q[recipient+"_hp"] = Q[recipient+"_hp_m"];
    } else if (Q[c+"_action"] == "socialize") {
        var stamina_cost = 4;
        var recipient = Q[c+"_target"];
        Q[c+"_"+recipient+"_buds"] = 1;
        Q[recipient+"_"+c+"_buds"] = 1;
    } else if (Q[c+"_action"] == "reinvigorate") {
        var stamina_cost = Q[c+"_sta"];
        for (var k of Q.combatants) {
            Q[k+"_sta"] += stamina_cost;
            if (Q[k+"_sta"] >= Q[k+"_sta_m"]) {
                Q[k+"_sta"] = Q[k+"_sta_m"];
            }
        }
        Q[c+"_sta"] = 0;
        stamina_cost = 0;
    } else if (Q[c+"_action"] == "finance") {
        var stamina_cost = 3;
        Q.resources += 1; 
    } else if (Q[c+"_action"] == "gallbladder_operation") {
        var stamina_cost = 0;
        Q[c+"_advisor"] = 0;
        Q[c+"_dead"] = 1; 
        Q.gallbladder_achievement = 1;   
    } else if (Q[c+"_action"] == "parry") {
        var stamina_cost = 2; 
        Q[c+"_parry_active"] = 1;
    } else if (Q[c+"_action"] == "diplomacy") {
        var stamina_cost = 4;
        Q[c+"_diplomacy_active"] = 1;
    } else if (Q[c+"_action"] == "attack") {
        var stamina_cost = 1;
        Q.gold_trigon_hp -= Q[c+"_att"];
    } else if (Q[c+"_action"] == "defend") {
        var stamina_cost = 1;
        if (Q[c+"_hp"] < Q[c+"_hp_m"]) {
            Q[c+"_hp"] += 1;
        }
        Q[c+"_insulated"] = 1;
    } else if (Q[c+"_action"] == "naptime") {
        var stamina_cost = 0;
        Q[c+"_sta"] += 3;
        if (Q[c+"_sta"] >= Q[c+"_sta_m"]) {
            Q[c+"_sta"] = Q[c+"_sta_m"];
        }
    }
    var stamina_discount = 0;
    for (var other of Q.combatants) {
        if (other != c && Q[c+"_"+other+"_buds"] && Q[c+"_action"] == Q[other+"_action"]) {
            stamina_discount = Math.floor(stamina_cost / 4);
            break;
        }
    }
    Q[c+"_sta"] -= stamina_cost;
    Q[c+"_sta"] += stamina_discount;
    if (Q[c+"_action"] == Q[c+"_plan"]) {
        Q[c+"_sta"] += Math.floor((stamina_cost)/2);
        stamina_cost -= Math.floor((stamina_cost)/2);
    }
    Q[c+"_action"] = "";
}

for (var c of Q.combatants) {
    Q[c + "_present_plan"] = Q[c + "_plan"]; 
    Q[c + "_plan"] = "";
}

!} 

- @next_turn: Who's next?
- @gold_trigon_turn: Proceed to the next turn
- @dummy

@gold_trigon_turn
view-if: not everyone_is_done
on-arrival: {! 

if (!Q.gold_trigon_moves || Q.gold_trigon_moves.length == 0) {
    Q.gold_trigon_moves = [];

    for (var i = 0; i < 5; i++) {
        var move_type = Math.floor(Math.random() * 3);
        var move;

        if (move_type == 0) {
            move = {
                type: "orb",
                target: Q.combatants[Math.floor(Math.random() * Q.combatants.length)]
            };

        } else if (move_type == 1) {
            move = {
                type: "laser",
                target: Q.combatants[Math.floor(Math.random() * Q.combatants.length)]
            };

        } else {
            var targets = {};

            for (var c of Q.combatants) {
                targets[c] = 0;
            }

            for (var j = 0; j < 8; j++) {
                var target = Q.combatants[Math.floor(Math.random() * Q.combatants.length)];
                targets[target] += 1;
            }

            move = {
                type: "triangles",
                targets: targets
            };
        }

        Q.gold_trigon_moves.push(move);
    }
}

var alive_combatants = Q.combatants.filter(function(c) {
    return !Q[c+"_dead"];
});

for (var move of Q.gold_trigon_moves) {
    if (move.type == "orb" || move.type == "laser") {
        if (Q[move.target+"_dead"]) {
            move.target = alive_combatants[
                Math.floor(Math.random() * alive_combatants.length)
            ];
        }
    }
}
for (var move of Q.gold_trigon_moves) {
    if (move.type != "triangles") {
        continue;
    }

    for (var dead_target in move.targets) {
        if (Q[dead_target+"_dead"]) {
            var amount = move.targets[dead_target];
            move.targets[dead_target] = 0;

            for (var i = 0; i < amount; i++) {
                var new_target = alive_combatants[
                    Math.floor(Math.random() * alive_combatants.length)
                ];

                move.targets[new_target] += 1;
            }
        }
    }
}

window.deathDialogueIfNeeded = function() { 
    if (Q[target+"_dead"]) {
       if (target == "hilferding") {
            trigonDialogues.push(
                ["doraemon", "Oh shoot! Hilferding just got incinerated, vaporized! Oh God!"],
                ["doraemon", "He's dead!"],
                ["doraemon", "Oh God!"],
                ["random_other_combatant", "He baked his last sale...", target],
                ["lassalle", "He baked his |what|?"],
                ["random_other_combatant", "LASSALLE?!|", target],
                ["doraemon", "It's just an apparition from the sworcerous plasma precipitated by the fact that it's currently a time of miracles, don't pay it any mind.|"],
                ["random_other_combatant", "Man, I must be seeing things...", target],
            );
        } else if (target == "wels") {
            trigonDialogues.push(
                ["doraemon", "Wels!!! No!!!|"],
                ["doraemon", "(For context, Wels died)|"],
                ["krupp", "||Ring ring|.|.|.|"],
                ["doraemon", "(Oh man.|)"],
                ["krupp", "Ring ring|.|.|.|"],
                ["krupp", "Hello? Anyone there?|||.||.|."],
                ["krupp", "Well, I'll just| leave a message.|.|."],
                ["krupp", "This is| kind of hard to say, but| I|||.||.|.||| love you.|"],
                ["krupp", "Wels, in all our conversations, I just"],
                ["krupp", "Wels, your voice"],
                ["krupp", "Your hair"],
                ["krupp", "Your eyes"],
                ["krupp", "The way you ask me for money"],
                ["krupp", "Even the way you use that money to campaign against my class interests"],
                ["krupp", "And always forget to pay me back"],
                ["krupp", "Every moment, Wels"],
                ["krupp", "I've been thinking how good it could b"],
                ["krupp", "Hold the phone"],
                ["krupp", "Is that Y|O|U|R pile of ash on the TV screen?|||"],
                ["krupp", "I...I gotta go."],
                ["doraemon", "That's crazy.|||"],
                ["random_other_combatant", "Moving on...", target],
            )
        } else if (target == "muller") {
            trigonDialogues.push(
                ["muller", "Oufgh-!|"],
                ["muller", ".|.|.|"],
                ["muller", "I... I think that hit me right in the gallbladder..."],
                ["muller", "Pretty hard.|.|.|"],
                ["muller", ".|.|.|I think I'm gonna need an||| operation."],
                ["muller", "I was||| scared this| day would come."],
                ["muller", "I-"],
                ["muller", "Oh, my-"],
                ["muller", "Oh no"],
                ["muller", "My gallbladder just fell out.|||"],
                ["doraemon", "Müller is dead!"],
            );
        } else if (target == "breitscheid") {
            trigonDialogues.push(
                ["breitscheid", "Jeeps..."],
                ["breitscheid", ".|.|.|"],
                ["breitscheid", "I see a light, brighter than the Trigon."],
                ["breitscheid", "A little blinking red light..."],
                ["breitscheid", "What religion is that from again.|.|.|?"],
                ["breitscheid", "I...I wanted to keep playing...|"],
                ["breitscheid", "This is a massive bummer. I'm really not jazzed about this.|"],
                ["doraemon", "Breitscheid is dead!"],
            );
        }
    }
}

var trigonDialogues = [];

var gold_trigon_move = Q.gold_trigon_moves.shift();

if (gold_trigon_move.type == "orb") {
    var target = gold_trigon_move.target;
    var raw_damage = 20;
    var damage = raw_damage * (10 / (10 + Q[target+"_def"]));
    if (Q[target+"_insulated"]) {
        damage *= 0.9;
    }
    damage = Math.floor(damage);
    Q[target+"_hp"] -= damage;
    if (Q[target+"_hp"] <= 0) {
        Q[target+"_dead"] = 1;
        Q[target+"_advisor"] = 0;
        window.deathDialogueIfNeeded();
    } else {
        if (target == "hilferding") {
            Q.hilferding_orbs = (Q.hilferding_orbs || 0) + 1;
            var orbDialogues = {
                1: [
                    ["hilferding", "OUFGH!"],
                    ["hilferding", "Wow! I just got hit by the same orb that incinerated Hitler!"],
                    ["hilferding", "Well, I'm still standing. So..."],
                    ["hilferding", "Heh. Yeah. Still standing."],
                    ["hilferding", "Whew..."],
                    ["doraemon", "Hilferding took " + damage + " damage from an orb!"],
                ],
                2: [
                    ["hilferding", "God, that hits hard!"],
                    ["hilferding", "How am I even still alive???"],
                    ["hilferding", "It must be the waffles in my stomach."],
                    ["hilferding", "Or the cookies I had for breakfast."],
                    ["hilferding", "Whew..."],
                    ["doraemon", "Hilferding took " + damage + " damage from an orb!"],
                ],
            };

            var dialogues = orbDialogues[Q.hilferding_orbs] || [
                ["hilferding", "Oof!|"],
                ["doraemon", "Hilferding took " + damage + " damage from an orb!"],
            ];

            trigonDialogues.push(...dialogues);
        } else if (target == "wels") {
            Q.wels_orbs = (Q.wels_orbs || 0) + 1;
            var orbDialogues = {
                1: [
                    ["doraemon", "Wels! Look out! There's a massive orb!|"],
                    ["wels", "Wh-"],
                    ["wels", "OW!|"],
                    ["wels", ".|.."],
                    ["wels", "Is that the same thing which hit Hitler? Wow, he's like, weak or something. That barely tickled."],
                    ["doraemon", "Wels took " + damage + " damage from an orb!"],
                ],
                2: [
                    ["wels", "Hehehehehehehehehehehehe"],
                    ["random_other_combatant", "What's so funny?|", target],
                    ["wels", "The orb tickles.|"],
                    ["doraemon", "Wels took " + damage + " damage from an orb!"],
                ],
            };

            var dialogues = orbDialogues[Q.wels_orbs] || [
                ["wels", "Hehehehehehehehehehehehe"],
                ["doraemon", "Wels took " + damage + " damage from an orb!"],
            ];

            trigonDialogues.push(...dialogues);
        } else if (target == "muller") {
            Q.muller_orbs = (Q.muller_orbs || 0) + 1;
            var orbDialogues = {
                1: [
                    ["muller", "Zoinks!!!"],
                    ["muller", "I just got hit by a massive spectral orb!"],
                    ["muller", "Yowch, that's gonna bruise..."],
                    ["muller", "Well, at least I'm still alive.|"],
                    ["doraemon", "Müller took " + damage + " damage from an orb!"],
                ],
                2: [
                    ["muller", "Ooof-!|"],
                    ["muller", "Really knocks the gall out of you. At least it didn't knock my bladder."],
                    ["muller", "Or my gallbladder.|"],
                    ["doraemon", "Müller took " + damage + " damage from an orb!"],
                ],
            };

            var dialogues = orbDialogues[Q.muller_orbs] || [
                ["muller", "Oooof...|"],
                ["doraemon", "Müller took " + damage + " damage from an orb!"],
            ];

            trigonDialogues.push(...dialogues);
        } else if (target == "breitscheid") {
            Q.breitscheid_orbs = (Q.breitscheid_orbs || 0) + 1;
            var orbDialogues = {
                1: [
                    ["breitscheid", "Grahhh-"],
                    ["breitscheid", "Okay, all things considered, given that killed Hitler, this is actually pretty groovy.|"],
                    ["breitscheid", "I'm officially stronger than Hitler.|"],
                    ["breitscheid", "Take that, fascism.|"],
                    ["doraemon", "Breitscheid took " + damage + " damage from an orb!"],
                ],
                2: [
                    ["breitscheid", "Mmmh.|"],
                    ["breitscheid", "I'm at least three times as strong as Hitler,| if my maths is right.|"],
                    ["breitscheid", "I'm pretty proud of that."],
                    ["doraemon", "Breitscheid took " + damage + " damage from an orb!"],
                ],
            };

            var dialogues = orbDialogues[Q.breitscheid_orbs] || [
                ["breitscheid", "I can only count to three, so I've lost track of how many times stronger than Hitler this makes me.|"],
                ["doraemon", "Breitscheid took " + damage + " damage from an orb!"],
            ];

            trigonDialogues.push(...dialogues);
        }
    }
} else if (gold_trigon_move.type == "laser") {
    var target = gold_trigon_move.target;

    var raw_damage = 16;
    var damage = raw_damage * (25 / (25 + Q[target+"_def"]));
    if (Q[target+"_insulated"]) {
        damage *= 0.95;
    }
    damage = Math.floor(damage);
    Q[target+"_hp"] -= damage;
    if (Q[target+"_hp"] <= 0) {
        Q[target+"_dead"] = 1;
        Q[target+"_advisor"] = 0;
        window.deathDialogueIfNeeded();
    } else {
        if (target == "hilferding") {
            Q.hilferding_lasers = (Q.hilferding_lasers || 0) + 1;
            var laserDialogues = {
                1: [
                    ["hilferding", "Is that a rainbow?|"],
                    ["hilferding", "I-"],
                    ["hilferding", "EEK!!!!!!!!!!!!!"],
                    ["doraemon", "Hilferding took " + damage + " damage from a laser!"],
                ],
                2: [
                    ["hilferding", "Eeek..."],
                    ["hilferding", "That thing hurts."],
                    ["hilferding", "Really zaps the hippocracy out of me."],
                    ["doraemon", "Hilferding took " + damage + " damage from a laser!"],
                ],
            };

            var dialogues = laserDialogues[Q.hilferding_lasers] || [
                ["hilferding", "Eek!|"],
                ["doraemon", "Hilferding took " + damage + " damage from a laser!"],
            ];

            trigonDialogues.push(...dialogues);
        } else if (target == "wels") {
            Q.wels_lasers = (Q.wels_lasers || 0) + 1;
            var laserDialogues = {
                1: [
                    ["wels", "Ouch.|"],
                    ["doraemon", "Wels took " + damage + " damage from a laser!"],
                ],
                2: [
                    ["wels", "You know, I've been thinking about this laser thing.|"],
                    ["wels", "The massive rainbow which falls from the sky and zaps us.|"],
                    ["wels", "I think it represents the pent-up mythopoetic aura which is permeating through reality in panpsychic fields that are accessed only through the challening of latent psionic potential into active psionic phenomenom by songs of sworcery, channeled through this prism of burdensome magic spilling out through the cracks that line the wall between material reality and the Kingdom of Heaven."],
                    ["wels", "Anyway, one just hit me."],
                    ["doraemon", "Wels took " + damage + " damage from a laser!"],
                ],
            };

            var dialogues = laserDialogues[Q.wels_lasers] || [
                ["wels", "Ouch."],
                ["doraemon", "Wels took " + damage + " damage from a laser!"],
            ];

            trigonDialogues.push(...dialogues);
        } else if (target == "muller") {
            Q.muller_lasers = (Q.muller_lasers || 0) + 1;
            var laserDialogues = {
                1: [
                    ["muller", "Oh my, is that a rainbow?|"],
                    ["muller", "I love rainbows. Little whimsical lights in the sky...!"],
                    ["muller", "Is there a pot of gold at the other end-?"],
                    ["muller", "OK no it's a laser"],
                    ["muller", "AAAAAAAAAAAAA"]
                    ["doraemon", "Müller took " + damage + " damage from a laser!"],
                ],
                2: [
                    ["muller", "I don't like rainbows anymore.|"],
                    ["muller", "As an atheist, this ruined my childhood.|"],
                    ["doraemon", "Müller took " + damage + " damage from a laser!"],
                ],
            };

            var dialogues = laserDialogues[Q.muller_lasers] || [
                ["muller", "Rain, rain, go away..."],
                ["doraemon", "Müller took " + damage + " damage from a laser!"],
            ];

            trigonDialogues.push(...dialogues);
        } else if (target == "breitscheid") {
            Q.breitscheid_lasers = (Q.breitscheid_lasers || 0) + 1;
            var laserDialogues = {
                1: [
                    ["breitscheid", "My Scythian friend loathes rainbows.|"],
                    ["breitscheid", "Brrrrghzzzzt"],
                    ["breitscheid", "Owwwwww.|"],
                    ["breitscheid", "Now I loathe rainbows too.|"],
                    ["doraemon", "Breitscheid took " + damage + " damage from a laser!"],
                ],
                2: [
                    ["breitscheid", "We Scythians loathe rainbows.|"],
                    ["doraemon", "Breitscheid took " + damage + " damage from a laser!"],
                ],
            };

            var dialogues = laserDialogues[Q.breitscheid_lasers] || [
                ["breitscheid", "What sucks the most is, I can't parry rainbows."],
                ["doraemon", "Breitscheid took " + damage + " damage from a laser!"],
            ];

            trigonDialogues.push(...dialogues);
        }
    }
} else if (gold_trigon_move.type == "triangles") {
    for (var target in gold_trigon_move.targets) {
        var amount = gold_trigon_move.targets[target];

        if (amount == 0) {
            continue;
        }

        var raw_damage = 3;
        var damage_per_triangle = raw_damage * (10 / (10 + Q[target+"_def"]));

        if (Q[target+"_insulated"]) {
            damage_per_triangle *= 0.9;
        }

        damage_per_triangle = Math.floor(damage_per_triangle);

        var damage = damage_per_triangle * amount;

        Q[target+"_hp"] -= damage;

        if (Q[target+"_hp"] <= 0) {
            Q[target+"_dead"] = 1;
            Q[target+"_advisor"] = 0;
            window.deathDialogueIfNeeded();
        } else {
            if (target == "hilferding") {
                Q.hilferding_triangles = (Q.hilferding_triangles || 0) + 1;
                var triangleDialogues = {
                    1: [
                        ["hilferding", "Huh? What are these-"],
                        ["hilferding", "These little-"],
                        ["hilferding", "Little flying triangles, I-"],
                        ["hilferding", "Get them off me!!! What if they carry malaria???"],
                        ["doraemon", "Hilferding took " + damage + " damage from " + amount + " triangles!"],
                    ],
                    2: [
                        ["hilferding", "Even if they don't carry malaria, they could carry like..."],
                        ["hilferding", "Japanese encephalitis!|"],
                        ["hilferding", "I'm not vaccinated for that.|"],
                        ["doraemon", "Hilferding took " + damage + " damage from " + amount + " triangles!"],
                    ],
                    3: [
                        ["hilferding", "I'm gonna have to invent a vaccine against these little critters..."],
                        ["hilferding", "I think this should work. I'll inject myself now."],
                        ["doraemon", "Hilferding took " + damage + " damage from " + amount + " triangles!"],
                    ]
                };

                var dialogues = triangleDialogues[Q.hilferding_triangles] || [
                    ["hilferding", "It's okay, I'm vaccinated now.|"],
                    ["doraemon", "Hilferding took " + damage + " damage from " + amount + " triangles!"],
                ];

                trigonDialogues.push(...dialogues);
            } else if (target == "wels") {
                 Q.wels_triangles = (Q.wels_triangles || 0) + 1;
                 var triangleDialogues = {
                    1: [
                        ["wels", "Uh, what are these-"],
                        ["wels", "HEY! They're-"],
                        ["wels", "Jesus, I-"],
                        ["wels", "I'm-"],
                        ["wels", "They zap hard!"],
                        ["wels", "Some voltage..."],
                        ["doraemon", "Wels took " + damage + " damage from " + amount + " triangles!"],
                    ],
                    2: [
                        ["wels", "Not more...||"],
                        ["doraemon", "Ough, gritty scene. Wels just got swarmed and absolutely scalded by a bunch of the triangles.|"],
                        ["wels", "You don't have to narrate my suffering, man.|"],
                        ["doraemon", "If I don't, how will the viewers follow?|"],
                        ["krupp", "Yeah Wels, that robot cat makes a great TV presenter.|"],
                        ["wels", "If you say so, Kruppy..."],
                        ["doraemon", "Wels took " + damage + " damage from " + amount + " triangles!"],
                    ],
                };

                var dialogues = triangleDialogues[Q.wels_triangles] || [
                    ["wels", ".|.|.|Sigh."],
                    ["doraemon", "Wels took " + damage + " damage from " + amount + " triangles!"],
                ];

                trigonDialogues.push(...dialogues);
            } else if (target == "muller") {
                 Q.muller_triangles = (Q.muller_triangles || 0) + 1;
                 var triangleDialogues = {
                    1: [
                        ["muller", "Ooh, what's this-?"],
                        ["muller", "-ach-"],
                        ["muller", "-little fairies, dazzle-"],
                        ["muller", "-eek-"],
                        ["muller", "-like Peter Pan-"],
                        ["muller", "-yowch-"],
                        ["doraemon", "Müller took " + damage + " damage from " + amount + " triangles!"],
                    ],
                    2: [
                        ["muller", "These aren't fairies, actually.||"],
                        ["muller", "They're more like the little glowing winged things from Rayman by Ubisoft.|||"],
                        ["random_other_combatant", "What?", target],
                        ["doraemon", "Müller took " + damage + " damage from " + amount + " triangles!"],
                    ],
                };

                var dialogues = triangleDialogues[Q.muller_triangles] || [
                    ["muller", "...they sting.|"],
                    ["doraemon", "Müller took " + damage + " damage from " + amount + " triangles!"],
                ];

                trigonDialogues.push(...dialogues);
            } else if (target == "breitscheid") {
                 Q.breitscheid_triangles = (Q.breitscheid_triangles || 0) + 1;
                 var triangleDialogues = {
                    1: [
                        ["breitscheid", "These remind me of fireflies..."],
                        ["breitscheid", "...in, really, the worst ways possible."],
                        ["breitscheid", "I mean, fireflies, aren't that good."],
                        ["breitscheid", "But at the least they don't scald with the energy of cosmic geometry beyond human comprehension."],
                        ["doraemon", "Breitscheid took " + damage + " damage from " + amount + " triangles!"],
                    ],
                    2: [
                        ["breitscheid", "...owch."],
                        ["doraemon", "Breitscheid took " + damage + " damage from " + amount + " triangles!"],
                    ],
                };

                var dialogues = triangleDialogues[Q.breitscheid_triangles] || [
                    ["breitscheid", "...I think I'm allergic.|"],
                    ["doraemon", "Breitscheid took " + damage + " damage from " + amount + " triangles!"],
                ];

                trigonDialogues.push(...dialogues);
            }
        }
    }
}

var id = window.queueCombatCutscene(trigonDialogues);
Q.combat_cutscene_queue.push(id);

if (Q.combat_cutscene_queue.length > 0) {
    window.startCombatCutscene(Q.combat_cutscene_queue.shift());
    return;
}

!}


