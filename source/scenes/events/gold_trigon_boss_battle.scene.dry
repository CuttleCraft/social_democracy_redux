@reinvigorate
title: Reinvigorate
subtitle: Spend turn reinvigorating everyone's morale with a passionate speech. Restore everyone's stamina by your own, while completely depleting your own. (up to 9 stamina) [? if sc_plan == "reinvigorate" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    Q[Q.selected_combatant + "_action"] = "reinvigorate";
    if (Q.selected_combatant == "wels") {
        Q.wels_reinvigorates = (Q.wels_reinvigorates || 0) + 1;

        var reinvigoratesDialogues = {
            1: [
                ["wels", "In this historic hour, we German Social Democrats solemnly pledge ourselves to the principles of humanity and justice, of freedom and socialism."],
                ["wels", "No psychocosmological geometric trifecta gives you the power to destroy ideas that are eternal and indestructible!|||"],
                ["random_other_combatant", "Inspirational...|"],
                ["random_other_combatant", "Hear, hear!|"],
                ["wels", "Heh...I was planning to give that speech against Hitler, but...well, circumstances changed.|"],
                ["doraemon", "Great speech!"],
                ["doraemon", "Wels has made a speech to inspire the combatants!"],
            ],
            2: [
                ["wels", "It is your duty to prevent civil war at all costs!"],
                ["wels", "I call upon you; three cheers for the free peoples' state!|"],
                ["random_other_combatant", "Hurrah!"],
                ["wels", "I was talking to the triangle..."],
                ["doraemon", "Wels has made a speech to inspire the combatants!"],
            ],
            3: [
                ["wels", "Together, we German Social Democrats form a circle, and as conformists we are squares, and this circle of squares will, uh...||"],
                ["doraemon", "I| feel like that speech could use a little more work."],
                ["wels", "Hm...|"],
                ["wels", "Okay, let me try again."],
                ["wels", "Down with the rule of the two-dimensional and rigidly angled, long live the supremacy of the unangularly free and three-dimensional proletarian spirit!"],
                ["random_other_combatant", "Yeah!!!"],
                ["doraemon", "Wels has made a speech to inspire the combatants!"],
            ],
        };

        var dialogues = reinvigoratesDialogues[Q.wels_reinvigorates] || [
            ["wels", "We are Friedrich Ebert, we carry the flame, we honor the programme, in Marx's name...!"],
            ["random_other_combatant", "Okay...!"],
            ["doraemon", "Wels has made a speech to inspire the combatants!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    }
} else {
    Q[Q.selected_combatant+"_plan"] = "reinvigorate";
}
!}
go-to: menu if planning_combat

<div class="combat-advisor-screen">

[+ sc_display +] will, at the cost of all stamina, reinvigorate the morale of all other combatants. The fieriness and effectiveness of the speech will directly correlate to the energy and gusto with which it is given. 

</div>

- @menu: Return

@finance
title: Finance
subtitle: Spend turn calling up German industry to fundraise for the struggle. Gain 1 resource. Resources can be spent to upgrade stats. (3 stamina) [? if sc_plan == "finance" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    Q[Q.selected_combatant + "_action"] = "finance";
    if (Q.selected_combatant == "wels") {
        Q.wels_finances = (Q.wels_finances || 0) + 1;

        var financesDialogues = {
            1: [
                ["wels", "Alright, time to make a phone call...| Ahem.|||.|||.|||"],
                ["wels", "Yo, my man.||"],
                ["krupp", "Sup.|||"],
                ["random_other_combatant", "Wh-?| Wels, you kn-"],
                ["wels", "I need a favor, my man.|"],
                ["doraemon", "(Who's this?)|"],
                ["random_other_combatant", "(Basically Hitler)|"],
                ["doraemon", "(Damn)"],
                ["wels", "Financial favor.|"],
                ["krupp", "You and your financial favors.|"],
                ["wels", "Look, it's not my fault we |socialists| can't do responsible accounting. That's a bourgeois skill,|| not a proletarian one.|"],
                ["krupp", "So you call the bourgeoisie to do your homework. Tsk...|"],
                ["wels", "Look at the news, man. It doesn't matter what channel.|"],
                ["doraemon", "Televisions aren't even a widespread way of checking the news yet..."],
                ["wels", "Shut it, Doraemon. I'm doing business.||"],
                ["krupp", "Oh, jeez. I'm just looking at the news now, I-"],
                ["krupp", "Wow, that's..."],
                ["krupp", "Okay. So where are you?||"],
                ["wels", "Oh, you know. Just| fighting the| thing. With my| bare hands.|"],
                ["krupp", "Oh, alright. Yeah I'll wire you some cash in a second.|"],
                ["wels", "Can you do it in the psychic plane? There's a sworcerous aura encasing the Reichstag so it should work.|"],
                ["krupp", "Yeah, yeah.| No problem.|"],
                ["doraemon", "Wels has called up German industry to finance the struggle!"],
            ],
            2: [
                ["wels", "Need more money.|"],
                ["krupp", "You owe me after this is all said and done.||"],
                ["wels", "No problem-o.|"],
                ["random_other_combatant", "Um, actually-"],
                ["wels", "We'll pay you back handsomely! Gotta go, bye!"],
                ["wels", "Look, it's this or we get obliterated, like Hitler did."],
                ["random_other_combatant", ".||.||."],
                ["doraemon", "Wels has called up German industry to finance the struggle!"],
            ],
            3: [
                ["wels", "Moshi moshi?|"],
                ["wels", "(For context, I'm a weeb)"],
                ["krupp", "Yes|?"],
                ["wels", "Can I get a ka-ching, amirite or amirite? Right?|"],
                ["krupp", "Sure can, bro.|"],
                ["wels", "Fistbump.|"],
                ["doraemon", "Wels has called up German industry to finance the struggle!"],
            ],
        };

        var dialogues = financesDialogues[Q.wels_finances] || [
            ["wels", "Moshi moshi, money money.|"],
            ["krupp", "Right on, kid.|"],
            ["doraemon", "Wels has called up German industry to finance the struggle!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    }
} else {
    Q[Q.selected_combatant+"_plan"] = "finance";
}
!}
go-to: menu if planning_combat

<div class="combat-advisor-screen">

[+ sc_display +] will, at the cost of 3 stamina, fundraise resources equivalent to 1, with which we may upgrade and hone the power and potential of our combatants.

