title: ...vs Gold Trigon
new-page: true
on-arrival: {!
window.setCombatHand(true);

const content = document.getElementById('content');

const choices = window.dendryUI.dendryEngine.getCurrentChoices();
console.log(choices);

Q.hilferding_hp = 21;
Q.hilferding_att = 3;
Q.hilferding_def = 9;
Q.hilferding_sta = 5;
Q.hilferding_sta_m = 5;

Q.wels_hp = 19;
Q.wels_att = 7;
Q.wels_def = 4;
Q.wels_sta = 9;
Q.wels_sta_m = 9;

Q.hilferding_action = "";
Q.hilferding_plan = "";

Q.wels_action = "";
Q.wels_plan = "";

Q.planning_combat = 0;
Q.plan_is_done = 0;

Q.choosing_target = 0;
Q.selected_combatant = 0;
Q.selected_target = 0;

const engine = window.dendryUI.dendryEngine;

Q.combatants = [];

const combatantIds = engine.game.tagLookup["combatant"] || {};

for (const id in combatantIds) {
  const scene = engine.game.scenes[id];

  if (!scene) {
    continue;
  }

  if (scene.viewIf && !engine._runPredicate(scene.viewIf, true)) {
    continue;
  }

Q.combatants.push(id.split(".").pop().replace(/_c$/, ""));

}

Q.everyone_is_done = 0;

!}
go-to: menu

= ...vs Gold Trigon

<div class="gold-trigon"></div>

<div class="combat-dialogue">
  <div class="combat-dialogue-portrait">
    <img id="combat-dialogue-image" src="" alt="">
  </div>
  <div id="combat-dialogue-text" class="combat-dialogue-text"></div>
</div>

@menu
on-arrival: {!
document.querySelectorAll('.combat-advisor-screen').forEach(el => el.remove());

window.setCombatHand(true);

if (!Q.doraemon_spoke) {
    window.showCombatDialogue("doraemon", "Holy smokes!");
    Q.doraemon_spoke = 1;
}

Q.everyone_is_done = 1;
for (var c of Q.combatants) {
    if (Q[c+'_action'] == "") {
        Q.everyone_is_done = 0;
    }
}
if (Q.choosing_target) {
    Q.everyone_is_done = 0;
}

Q.plan_is_done = 1;
if (Q.planning_combat) {
    for (var c of Q.combatants) {
        if (Q[c + "_plan"] == "") {
            Q.plan_is_done = 0;
        }
    }
}

!}

[? if planning_combat : We are planning - all actions we select are for the **next turn**, rather than the current one. ?]

- #combatant
- @next_turn: Submit the selected actions
- @finalize_plan: Finalize the battle plan

@hilferding_c
title: Rudolf Hilferding
is-pinned-card: true
tags: combatant
card-image: img/portraits/HilferdingRudolf.jpg
view-if: (hilferding_advisor = 1) and (not choosing_target or (selected_combatant != "hilferding"))
on-arrival: selected_combatant = "hilferding" if not choosing_target; selected_target = "hilferding" if choosing_target; sc_display = "Hilferding" if not choosing_target; sc_plan = hilferding_plan if not choosing_target
go-to: target_chosen if choosing_target

<div class="combat-advisor-screen">

HP: [+ hilferding_hp +]
Attack: [+ hilferding_att +]
Defense: [+ hilferding_def +]
Stamina: [+ hilferding_sta +]

</div>

- @attack
- @defend
- @hilferding_abilities: Let's explore Hilferding's special abilities.
- @menu: Return

@hilferding_abilities
subtitle: Strategize - Medicine - Socialize

<div class="combat-advisor-screen">

Rudolf Hilferding has some tricks up his sleeve.

</div>

- @strategize
- @medicine
- @socialize

@strategize
title: Strategize
subtitle: Spend turn planning the battle ahead. The next turn, stamina cost for all abilities will be halved, but have to be decided now (3 stamina) [? if sc_plan == "strategize" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    Q[Q.selected_combatant + "_action"] = "strategize";
    Q.planning_combat = 1;
} else {
    Q[Q.selected_combatant+"_plan"] = "strategize";
}
!}

<div class="combat-advisor-screen">

[+ sc_display +] will, at the cost of 3 stamina, use their expertise in political strategization and theorization to formulate a battle plan for the next turn after this one. When the battle plan is finalized, it can be implemented. We are now **drafting the plan** - before finalizing our combatants' actions for this turn, please complete the plan for the next turn.

</div>

- @menu: Return

@medicine
title: Medicine
subtitle: Spend turn treating another combatant. Selected combatant will have full health, but will also have to spend their turn being treated (5 stamina) [? if sc_plan == "medicine" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    Q[Q.selected_combatant + "_action"] = "medicine";
    Q.choosing_target = 1;
} else {
    Q[Q.selected_combatant+"_plan"] = "medicine";
}
!}
go-to: menu if planning_combat

<div class="combat-advisor-screen">

Select a target.

</div>

- #combatant

@socialize
title: Socialize
subtitle: Spend turn using his experience and knowledge on socialization to make friends with one fellow combatant. Once friends, they will get a bonus when taking the same actions as each other. (4 stamina) [? if sc_plan == "socialize" : - **this is our plan** ?]
on-arrival: {!
if !(Q.planning_combat) {
    Q[Q.selected_combatant + "_action"] = "socialize";
    Q.choosing_target = 1;
} else {
    Q[Q.selected_combatant+"_plan"] = "socialize";
}
!}
go-to: menu if planning_combat

<div class="combat-advisor-screen">

Select a target.

</div>

- #combatant

