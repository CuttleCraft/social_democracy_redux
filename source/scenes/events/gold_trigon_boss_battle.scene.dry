        if (Q.selected_target == "wels") {
            var dialogues = [
                ["hilferding", "Hey, Wels."],
                ["wels", "Sup."],
                ["hilferding", "Nothing much, you?"],
                ["wels", "Eh, the usual."],
                ["hilferding", "Yeah, same."],
                ["hilferding", "Oh, and the cosmic geometry affair.|"],
