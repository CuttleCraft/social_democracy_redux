title: ...vs Gold Trigon
new-page: true
on-arrival: {!
window.setCombatHand(true);

const content = document.getElementById('content');

const choices = window.dendryUI.dendryEngine.getCurrentChoices();
console.log(choices);

Q.hilferding_hp = 21;
Q.hilferding_att = 3;
Q.hilferding_def = 9;
Q.hilferding_sta = 5;
Q.hilferding_sta_m = 5;

Q.wels_hp = 19;
Q.wels_att = 7;
Q.wels_def = 4;
Q.wels_sta = 9;
Q.wels_sta_m = 9;

!}
go-to: menu

= ...vs Gold Trigon

<div class="gold-trigon"></div>

<div class="combat-dialogue">
  <div class="combat-dialogue-portrait">
    <img id="combat-dialogue-image" src="" alt="">
  </div>
  <div id="combat-dialogue-text" class="combat-dialogue-text"></div>
</div>

@menu
on-arrival: {!
document.querySelectorAll('.combat-advisor-screen').forEach(el => el.remove());

window.setCombatHand(true);

if (!Q.doraemon_spoke) {
    window.showCombatDialogue("doraemon", "Holy smokes!");
    Q.doraemon_spoke = 1;
}
!}

- #combatant

@hilferding_c
title: Rudolf Hilferding
is-pinned-card: true
tags: combatant
card-image: img/portraits/HilferdingRudolf.jpg
view-if: hilferding_advisor = 1
on-arrival: selected_combatant = "hilferding"

<div class="combat-advisor-screen">

HP: [+ hilferding_hp +]
Attack: [+ hilferding_att +]
Defense: [+ hilferding_def +]
Stamina: [+ hilferding_sta +]

</div>

- @attack
- @defend
- @hilferding_abilities: Let's explore Hilferding's special abilities.
- @menu: Return

@hilferding_abilities
subtitle: Strategize - Medicine - Socialize

<div class="combat-advisor-screen">

Rudolf Hilferding has some tricks up his sleeve.

</div>

@wels_c
title: Otto Wels
is-pinned-card: true
tags: combatant
card-image: img/portraits/WelsOtto.jpg
view-if: wels_advisor = 1
on-arrival: selected_combatant = "wels"

<div class="combat-advisor-screen">

HP: [+ wels_hp +]
Attack: [+ wels_att +]
Defense: [+ wels_def +]
Stamina: [+ wels_sta +]

</div>

- @menu: Return

@attack
title: Attack the **<span style="color:rgb(255, 208, 0);font-family:'Times New Roman',serif;font-weight:700;letter-spacing:0.5px;">Gold Trigon</span>**.
subtitle: An ordinary attack, dealing damage. (1 stamina)

@defend
title: Take a defensive stance and attempt to heal.
subtitle: An ordinary defense, regaining 1 HP. (1 stamina)
