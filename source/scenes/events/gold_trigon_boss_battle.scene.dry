- @menu: Return

@target_chosen
on-arrival: {! 
if (Q.socialize_cutscene_tbd) {
    Q.socialize_cutscene_tbd = 0;
    if (Q.selected_combatant == "hilferding") {
        if (Q.selected_target == "wels" && !Q.hilferding_wels_buds) {
            var dialogues = [
                ["hilferding", "Hey, Wels.|"],
                ["wels", "Sup.|"],
                ["hilferding", "Nothing much, you?|"],
                ["wels", "Eh, the usual.|"],
                ["hilferding", "Yeah, same.|"],
                ["hilferding", "Oh, and the cosmic geometry affair.|"],
                ["wels", "Oh yeah, there's that whole showbizz.|"],
                ["hilferding", "Wanna be friends?|"],
                ["wels", "What?"],
                ["wels", "Man, what are you talking about?"],
                ["wels", "We've been friends for a while now.|"],
                ["hilferding", "Is that a yes?|"],
                ["wels", "I mean,|||||| y-"],
                ["hilferding", "Great we can synergize our actions now, see you later Wels!|"],
                ["doraemon", "Hilferding has befriended Wels!"],
            ];
        } else if (Q.selected_target == "muller" && !Q.hilferding_muller_buds) {
            var dialogues = [
                ["hilferding", "Hi, Müller.|"],
                ["muller", "Hello.|"],
                ["hilferding", "How's the gallbladder?|"],
                ["muller", "Good, good. As an atheist, I find it helps to read it a bed time story everynight.||"],
                ["hilferding", "Yeah, totally.| Hey, so are we friends?"],
                ["muller", "Sure thing.|"],
                ["hilferding", "Sweet! Thanks."],
                ["doraemon", "Hilferding has befriended Müller!"],
            ];
        } else if (Q.selected_target == "breitscheid" && !Q.hilferding_breitscheid_buds) {
            var dialogues = [
                ["hilferding", "Yo, Breitscheid.|"],
                ["breitscheid", "Howdy.|"],
                ["hilferding", "Can you tell me more about our woeful errand? I don't know what it is with you specifically, but you seem totally in the know with this stuff.|"],
                ["breitscheid", "It doesn't have me too stoked but yeah basically our woeful errand is, okay, so.|"],
                ["breitscheid", "I'll start from the beginning.|.|.|"],
                ["breitscheid", "There is a spectre haunting Mingi Taw.|"],
                ["hilferding", "The spectre of.|.|.|communism?"],
                ["breitscheid", "No.| Far more sinister.|"],
                ["hilferding", "What could be more sinister than communism?"],
                ["breitscheid", "Wh- okay, so like, first off, fascism.|"],
                ["hilferding", "Oh yeah."],
                ["breitscheid", "|But that's not it, either.| It's the deathless spectre haunting the darkness beneath Mingi Taw, that we need to banish the immortality from.|"],
                ["hilferding", "Riiiiiiiiiight."],
                ["breitscheid", "Because it's haunting us too, I'm pretty sure.|"],
                ["hilferding", "And you're sure it's not communism?|"],
                ["breitscheid", "Of course I'm sure, Hilferding. Stop being a chud."],
                ["hilferding", "But nothing ever happens..."],
                ["breitscheid", "Sir there's a massive deity in the room with us right now.|"],
                ["hilferding", "Right. Okay. Whatever. Just wanted to confirm, we're friends right?"],
                ["breitscheid", "Uh, yeah? So anyway, about the deathless spectre-"],
                ["hilferding", "Eh who cares, your story's too long. Get better at prose. Maybe one day you'll be able to write something as good and insightful as Finance Capital. See you!"],
                ["breitscheid", "...are we really friends...?"],
                ["doraemon", "Yes! His ability says so!"],
                ["doraemon", "Hilferding has befriended Breitscheid!"],
            ];
        } else {
            var dialogues = [
                ["hilferding", "Hi.|"],
                [Q.hilferding_target, "You already did this. You just wasted a turn. For both of us.|"],
                ["hilferding", "Oh yeah.|"],
                ["doraemon", "Hilferding wasted a turn!|"],
            ]
        }
    if (!Q.doraemon_narrated) {
        dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
        Q.doraemon_narrated = 1;
    }

    var id = window.queueCombatCutscene(dialogues);
    Q.combat_cutscene_queue.push(id);
    }
}
Q[Q.selected_combatant+"_target"] = Q.selected_target;
if (Q.consumes_turns) {
    Q[Q.selected_target+"_action"] = "immobile";
    Q.consumes_turns = 0;
}
Q.selected_combatant = 0;
Q.selected_target = 0;
Q.choosing_target = 0;

!}

