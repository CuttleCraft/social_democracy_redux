@strategize
title: Strategize
choose-if: sc_stamina >= 3
subtitle: Spend turn planning the battle ahead. The next turn, stamina cost for all abilities will be halved, but have to be decided now (3 stamina) [? if sc_plan == "strategize" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    window.clearCombatStatsIfNeeded();
    Q[Q.selected_combatant + "_action"] = "strategize";
    Q.planning_combat = 1;
    
    if (Q.selected_combatant == "hilferding") {
        Q.hilferding_strategies = (Q.hilferding_strategies || 0) + 1;

        var strategyDialogues = {
            1: [
                ["hilferding", "This strange apparition of seemingly cosmic geometry represents an unprecedented progression in the development of global finance-capitalism. In this thesis, we will aim to-"],
                ["random_other_combatant", "Hilfy, I don't think-"],
                ["hilferding", "Be quiet. The socialist movement must correctly diagnose the historical sociomaterial conditions which led to the emergence of this triangular manifestation, in order to address its response."],
                ["hilferding", "Hm..."],
                ["hilferding", "Yes. I see it. This apparition of cosmic geometry represents an aspect of the bourgeois superstructure yet also simultaneously a means of production in itself, and must therefore be dismantled and proletarianized pursuant to its expropriation."],
                ["hilferding", "We will accomplish this by rocking its shit violence-style.|"],
                ["random_other_combatant", "Ohhh. Okay. Sure, I can agree with that.|"],
                ["doraemon", "Hilferding has made a battle plan for the next turn!"],
            ],
            2: [
                ["hilferding", "The policy of cosmic geometry is bound to lead towards war, and hence to the unleashing of revolutionary storms.|"],
                ["random_other_combatant", "Amen.|"],
                ["hilferding", "Now, then, is the issue of how we as revolutionaries should seek to unleash our storms."],
                ["hilferding", "Hm..."],
                ["hilferding", "Doraemon, any ideas?"],
                ["doraemon", "No???"],
                ["hilferding", "Come on. Are you even a Marxist?"],
                ["doraemon", "I'm not!|"],
                ["hilferding", "Wait, really? Damn."],
                ["hilferding", "Well, that's okay. I figured it out myself."],
                ["hilferding", "We just need to beat its ass, basically."],
                ["hilferding", "I wrote the specifics down in my notepad."],
                ["doraemon", "Hilferding has made a battle plan for the next turn!"],
            ],
            3: [
                ["hilferding", "Maybe if we tried baking cookies..."],
                ["hilferding", "Then doing a bakesale..."],
                ["hilferding", "Hm...|"],
                ["hilferding", "No, that wouldn't work."],
                ["hilferding", "I'll just have to do things in my rough and tumble dirty wifebeaterly sort of way."],
                ["braun", "I get that reference!"],
                ["hilferding", "Braun, shut up. Nobody cares about Homestuck."],
                ["braun", "But you just referenced it!"],
                ["doraemon", "Hilferding has made a battle plan for the next turn!"],
            ],
        };

        var dialogues = strategyDialogues[Q.hilferding_strategies] || [
            ["hilferding", "I am an immaculate theorist."],
            ["hilferding", "Read my theories now."],
            ["random_other_combatant", "Okay..."],
            ["doraemon", "Hilferding has made a battle plan for the next turn!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    }
} else {
    Q[Q.selected_combatant+"_plan"] = "strategize";
    Q.was_already_planning_combat = 1;
}

!}
go-to: menu if was_already_planning_combat

<div class="combat-advisor-screen">

[+ sc_display +] will, at the cost of 3 stamina, use their expertise in political strategization and theorization to formulate a battle plan for the next turn after this one. When the battle plan is finalized, it can be implemented. We are now **drafting the plan** - before finalizing our combatants' actions for this turn, please complete the plan for the next turn.

</div>

- @menu: Return

@medicine
title: Medicine
choose-if: sc_stamina >= 5
subtitle: Spend turn treating another combatant. Selected combatant will have full health, but will also have to spend their turn being treated (5 stamina) [? if sc_plan == "medicine" : - **this is our plan** ?]
on-arrival: {!
if (!Q.planning_combat) {
    window.clearCombatStatsIfNeeded();
    Q[Q.selected_combatant + "_action"] = "medicine";
    Q.choosing_target = 1;
    Q.consumes_turns = 1;
    if (Q.selected_combatant == "hilferding") {
        Q.hilferding_medicines = (Q.hilferding_medicines || 0) + 1;

        var medicineDialogues = {
            1: [
                ["hilferding", "Now, now. I've done this before. It's really simple. You ready to be treated?|"],
                ["combatant_target", "Uhh...| I guess so. It's gotta be done."],
                ["hilferding", "It's for your own wellbeing and health. Don't worry, I've recently made massive strides in the field of medical treatment using knowledge gained through the Megatome, so all I need to do is inject you with the elixir of eternal life."],
                ["combatant_target", "Wait, wh-?"],
                ["doraemon", "Hilferding has treated his patient!"],
            ],
            2: [
                ["hilferding", "You know, I used to work in Vienna as a paediatrician.|"],
                ["doraemon", "Oh, so that's the historical basis for your ability?|"],
                ["hilferding", "Pretty much. I studied medicine in university.|"],
                ["doraemon", "Cool.|||"],
                ["doraemon", "Hilferding has treated his patient!"],
                ["combatant_target", "I didn't even get a line of dialogue for that one..."],
                ["doraemon", "Too bad! You've been treated!"],
            ],
            3: [
                ["hilferding", "For today's treatment, I baked the elixir of eternal life into your cookies."],
                ["hilferding", "I just wanted to incorporate my passion for baking into this somehow.|"],
                ["doraemon", "What's the historical basis for that?|"],
                ["combatant_target", "Hilferding's cookies are world famous. Don't tell me you haven't tried one.|"],
                ["doraemon", "Huh, okay. I didn't realize."],
                ["doraemon", "So can I have one?|"],
                ["hilferding", "Nope, sorry. Ran out of dough."],
                ["doraemon", "Shucks, buster."],
                ["doraemon", "Hilferding has given his patient cookies!"],
            ],
        };

        var dialogues = medicineDialogues[Q.hilferding_medicines] || [
            ["hilferding", "By the way, the elixir of eternal life?"],
            ["hilferding", "It actually doesn't give you eternal life."],
            ["combatant_target", "I figured."],
            ["doraemon", "Hilferding has treated his patient!"],
        ];

        if (!Q.doraemon_narrated) {
            dialogues.push(["doraemon", "Why am I narrating? Uhh, look, man, somebody has to!"]);
            Q.doraemon_narrated = 1;
        }

        var id = window.queueCombatCutscene(dialogues);
        Q.combat_cutscene_queue.push(id);
    }
} else {
    Q[Q.selected_combatant+"_plan"] = "medicine";
}

!}
