- @menu: Return

@attack
title: Attack the **<span style="color:rgb(255, 208, 0);font-family:'Times New Roman',serif;font-weight:700;letter-spacing:0.5px;">Gold Trigon</span>**.
subtitle: An ordinary attack, dealing damage. (1 stamina)
on-arrival: {!
Q[selected_combatant + "_action"] = "attack";
!}
go-to: menu

@defend
title: Take a defensive stance and attempt to heal.
subtitle: An ordinary defense, regaining 1 HP. (1 stamina)
on-arrival: {!
Q[selected_combatant + "_action"] = "defend";
!}
go-to: menu

@next_turn
view-if: everyone_is_done
on-arrival: everyone_is_done = 0; {! 

for (var c of Q.combatants) {
    Q[selected_combatant+"_action"] = 0;
    Q[c+"_action"] = "";
    // later obv do stuff with the actions before clearing them to resolve turn, for now want to get down the stuff that would have to be cleared
}

window.showCombatDialogue("doraemon", "Nice job! You just did something. I support doing things.");

!} 

<div class="combat-advisor-screen">

We attack the Gold Trigon.

</div>

- @menu: Return
